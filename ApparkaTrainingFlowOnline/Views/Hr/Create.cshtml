@model CreateCollaboratorViewModel
@{ ViewData["Title"] = "Nuevo colaborador"; }
<section class="page-header"><p class="eyebrow">ALTA Y PROGRAMACIÓN</p><h1>Registrar nuevo colaborador</h1><p>El sistema generará seis actividades distribuidas automáticamente en 21 días.</p></section>
<form asp-action="Create" method="post" class="card form-card">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="form-grid">
        <div><label asp-for="FullName">Nombre completo</label><input asp-for="FullName" /><span asp-validation-for="FullName"></span></div>
        <div><label asp-for="Email">Correo personal o corporativo</label><input asp-for="Email" /><span asp-validation-for="Email"></span></div>
        <div><label asp-for="IdentityDocument">Documento de identidad</label><input asp-for="IdentityDocument" inputmode="text" autocomplete="off" placeholder="DNI o CE" /><span asp-validation-for="IdentityDocument"></span></div>
        <div><label asp-for="Phone">Teléfono</label><input asp-for="Phone" inputmode="tel" autocomplete="tel" placeholder="Ej. 987654321" /><span asp-validation-for="Phone"></span></div>
    </div>
    <div class="form-grid" data-location-supervisor-link>
        <div><label asp-for="LocationId">Sede</label><select asp-for="LocationId" asp-items="Model.Locations" data-location-select><option value="">Seleccionar</option></select><span asp-validation-for="LocationId"></span></div>
        <div>
            <label asp-for="SupervisorId">Supervisor responsable</label>
            <select asp-for="SupervisorId" data-supervisor-select>
                <option value="">Seleccionar</option>
                @foreach (var supervisor in Model.Supervisors)
                {
                    var supervisorId = int.Parse(supervisor.Value);
                    var locationIds = Model.SupervisorLocationIds.GetValueOrDefault(supervisorId, Array.Empty<int>());
                    <option value="@supervisor.Value" data-location-ids="@string.Join(',', locationIds)" selected="@(Model.SupervisorId == supervisorId ? "selected" : null)">@supervisor.Text</option>
                }
            </select>
            <span asp-validation-for="SupervisorId"></span>
        </div>
        <p class="linked-select-help" data-location-supervisor-help>Elige una sede para ver únicamente sus supervisores, o elige primero un supervisor para limitar las sedes disponibles.</p>
    </div>
    <div class="form-grid">
        <div><label asp-for="AccessFrom">Acceso a materiales desde</label><input asp-for="AccessFrom" /><span asp-validation-for="AccessFrom"></span></div>
        <div><label asp-for="StartDate">Primer día de trabajo</label><input asp-for="StartDate" /><span asp-validation-for="StartDate"></span></div>
    </div>
    <input asp-for="PositionId" type="hidden" />
    <div class="info-box"><strong>Perfil de entrenamiento</strong><p>Anfitrión Red Comercial. La plataforma está enfocada exclusivamente en este puesto.</p></div>
    <div class="info-box"><strong>Programación automática</strong><p>Semana 1: días 1–7 · Semana 2: días 8–14 · Semana 3: días 15–21. Cada semana contiene dos evidencias con plazo propio.</p></div>
    <div class="form-actions"><a class="button ghost" asp-action="Index">Cancelar</a><button class="button primary" type="submit">Crear periodo de prueba</button></div>
</form>

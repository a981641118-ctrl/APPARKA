@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-brand"><span class="brand-mark large">A</span></div>
        <p class="eyebrow">APPARKA TRAINING FLOW</p>
        <h1>Ingresa a tu capacitación</h1>
        <p class="muted">Acceso seguro desde celular, tablet o computadora.</p>
        <form asp-action="Login" method="post" class="stack-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Email">Correo</label>
            <input asp-for="Email" autocomplete="username" placeholder="nombre@empresa.com" />
            <span asp-validation-for="Email"></span>
            <label asp-for="Password">Contraseña</label>
            <input asp-for="Password" autocomplete="current-password" placeholder="••••••••" />
            <span asp-validation-for="Password"></span>
            <button class="button primary full" type="submit">Ingresar</button>
            <a class="auth-help-link" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
        </form>
    </section>
</div>

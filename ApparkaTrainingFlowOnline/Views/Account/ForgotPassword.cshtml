@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Recuperar contraseña"; }
<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-brand"><span class="brand-logo large" role="img" aria-label="Apparka Training Flow"><img src="~/images/apparka-training-flow-brand.png" alt="" /></span></div>
        <p class="eyebrow">RECUPERACIÓN DE ACCESO</p>
        <h1>¿Olvidaste tu contraseña?</h1>
        <p class="muted">Ingresa tu correo registrado. Si la cuenta está activa, recibirás un enlace temporal.</p>
        <form asp-action="ForgotPassword" method="post" class="stack-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Email">Correo</label>
            <input asp-for="Email" autocomplete="email" placeholder="nombre@empresa.com" />
            <span asp-validation-for="Email"></span>
            <button class="button primary full" type="submit">Enviar enlace</button>
            <a class="auth-help-link" asp-action="Login">Volver al inicio de sesión</a>
        </form>
    </section>
</div>

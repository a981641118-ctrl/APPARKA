@model ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; }
<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-brand"><span class="brand-mark large">A</span></div>
        <p class="eyebrow">ACCESO SEGURO</p>
        <h1>Crea una nueva contraseña</h1>
        <p class="muted">Debe contener al menos ocho caracteres.</p>
        <form asp-action="ResetPassword" method="post" class="stack-form">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Password">Nueva contraseña</label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
            <label asp-for="ConfirmPassword">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
            <button class="button primary full" type="submit">Guardar contraseña</button>
        </form>
    </section>
</div>

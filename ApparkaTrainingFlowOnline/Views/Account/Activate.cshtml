@model ActivateViewModel
@{ ViewData["Title"] = "Activar cuenta"; }
<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-brand"><span class="brand-logo large"><img src="~/images/apparka-training-flow-logo.svg" asp-append-version="true" alt="Apparka Training Flow" /></span></div>
        <p class="eyebrow">ACCESO PREVIO</p>
        <h1>Activa tu cuenta</h1>
        <p class="muted">Crea una contraseña para revisar tus materiales antes del primer día.</p>
        <form asp-action="Activate" method="post" class="stack-form">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Password">Nueva contraseña</label>
            <div class="password-field"><input asp-for="Password" autocomplete="new-password" /><button type="button" class="password-toggle" data-password-toggle aria-label="Mostrar contraseña" title="Mostrar contraseña"><span aria-hidden="true">👁</span></button></div>
            <span asp-validation-for="Password"></span>
            <label asp-for="ConfirmPassword">Confirmar contraseña</label>
            <div class="password-field"><input asp-for="ConfirmPassword" autocomplete="new-password" /><button type="button" class="password-toggle" data-password-toggle aria-label="Mostrar contraseña" title="Mostrar contraseña"><span aria-hidden="true">👁</span></button></div>
            <span asp-validation-for="ConfirmPassword"></span>
            <button class="button primary full" type="submit">Activar acceso</button>
        </form>
    </section>
</div>

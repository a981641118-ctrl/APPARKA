@model TrainingAssignment
@{ ViewData["Title"] = "Acceso programado"; }
<section class="empty-card"><div class="big-icon">⌛</div><p class="eyebrow">ACCESO PROGRAMADO</p><h1>Tu contenido estará disponible pronto</h1><p>Recursos Humanos programó tu acceso desde el <strong>@Model.AccessFrom.ToString("dd/MM/yyyy")</strong>. Tu primer día de trabajo es el <strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong>.</p><p class="assignment-supervisor centered">Supervisor responsable: <strong>@Model.Supervisor.FullName</strong></p><form asp-controller="Account" asp-action="Logout" method="post"><button class="button secondary" type="submit">Cerrar sesión</button></form></section>

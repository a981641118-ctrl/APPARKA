<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#102a43" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <title>@ViewData["Title"] - Apparka Training Flow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">A</span>
            <span><strong>Training Flow</strong><small>Validación de competencias</small></span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="user-actions">
                <span class="user-name">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="icon-button" type="submit" aria-label="Cerrar sesión">Salir</button>
                </form>
            </div>
        }
    </header>

    <main class="main-content">
        @if (TempData["Success"] is string success)
        {
            <div class="toast success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast error">@error</div>
        }
        @RenderBody()
    </main>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="bottom-nav" aria-label="Navegación principal">
            <a asp-controller="Home" asp-action="Index"><span>⌂</span>Inicio</a>
            @if (User.IsInRole(AppRoles.Collaborator))
            {
                <a asp-controller="Training" asp-action="Index"><span>✓</span>Mi proceso</a>
            }
            @if (User.IsInRole(AppRoles.Supervisor) || User.IsInRole(AppRoles.Administrator))
            {
                <a asp-controller="Supervisor" asp-action="Dashboard"><span>!</span>Supervisión</a>
            }
            @if (User.IsInRole(AppRoles.Hr) || User.IsInRole(AppRoles.Administrator))
            {
                <a asp-controller="Hr" asp-action="Index"><span>♙</span>Personas</a>
            }
            @if (User.IsInRole(AppRoles.Administrator))
            {
                <a asp-controller="Admin" asp-action="Index"><span>⚙</span>Admin</a>
            }
        </nav>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
